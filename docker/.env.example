# ============================================================
# ToonFlow 部署配置（复制为 .env 后修改）
#   cp .env.example .env
# ============================================================

# 对外暴露端口（浏览器访问 http://<服务器IP>:$HOST_PORT）
HOST_PORT=2280

# 应用内部端口（容器内 Node.js 监听，一般无需修改）
APP_PORT=10588

# 运行环境：prod
NODE_ENV=prod

# ============================================================
# 默认登录账号（首次启动由 initDB 写入数据库）
# ============================================================
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=please-change-me

# ============================================================
# 数据库配置（MySQL，复用外部实例）
# 容器内访问宿主机服务用 host.docker.internal
# ============================================================
DB_CLIENT=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=toonflow_user
DB_PASSWORD=change-me
DB_NAME=toonflow_db

# ============================================================
# 对象存储配置（MinIO，复用外部实例）
# ============================================================
OSS_ENDPOINT=host.docker.internal:9000
OSS_ACCESS_KEY=toonflow-key
OSS_SECRET_KEY=change-me
OSS_BUCKET=toonflow
OSS_USE_SSL=false
